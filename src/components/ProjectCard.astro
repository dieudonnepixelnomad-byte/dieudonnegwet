---
import ArrowIcon from './ArrowIcon.astro';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  slug: string;
  title: string;
  category: string;
  reference: string;
  excerpt: string;
  visual: 'learning' | 'ride' | 'alert' | 'books';
  statusLabel: string;
}
const { slug, title, category, reference, excerpt, visual, statusLabel } = Astro.props;
---

<article class="project-card">
  <a class="project-card__visual" href={`/realisations/${slug}`} tabindex="-1" aria-hidden="true">
    <ProjectVisual kind={visual} title={title} compact />
  </a>
  <div class="project-card__content">
    <div class="project-card__meta"><span>{reference}</span><span>{category}</span></div>
    <h3><a href={`/realisations/${slug}`}>{title}</a></h3>
    <p>{excerpt}</p>
    <div class="project-card__footer">
      <span>{statusLabel}</span>
      <a class="link-arrow" href={`/realisations/${slug}`}>Voir le dossier <ArrowIcon /></a>
    </div>
  </div>
</article>

<style>
  .project-card { display: grid; overflow: hidden; border: 1px solid var(--border-default); background: var(--surface-raised); }
  .project-card__visual { display: block; }
  .project-card__content { display: grid; align-content: start; padding: var(--space-5); }
  .project-card__meta, .project-card__footer > span { color: var(--text-secondary); font: 500 var(--font-size-label)/1.4 var(--font-utility); letter-spacing: 0.04em; text-transform: uppercase; }
  .project-card__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); }
  .project-card h3 { margin-top: var(--space-6); }
  .project-card h3 a { text-decoration: none; }
  .project-card h3 a:hover { color: var(--accent-proof); }
  .project-card p { margin: var(--space-4) 0 var(--space-6); color: var(--text-secondary); }
  .project-card__footer { align-self: end; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--border-default); }
</style>

