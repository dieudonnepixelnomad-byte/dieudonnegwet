---
import liliBooksImage from '@/assets/projects/lili-books.png';
import { Image } from 'astro:assets';

interface Props { kind: 'learning' | 'ride' | 'alert' | 'books'; title: string; compact?: boolean }
const { kind, title, compact = false } = Astro.props;
---

<div class:list={['project-visual', `project-visual--${kind}`, { 'project-visual--compact': compact }]}>
  {kind === 'learning' && (
    <div class="learning-map" aria-hidden="true">
      <span class="class-pill">CM1 · Mathématiques</span>
      <div class="score score--before"><small>AVANT</small><strong>35%</strong></div>
      <svg viewBox="0 0 120 30"><path d="M2 24C32 25 40 20 57 17s30-13 61-15" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      <div class="score score--after"><small>APRÈS</small><strong>72%</strong></div>
    </div>
  )}
  {kind === 'ride' && (
    <div class="route-map" aria-hidden="true">
      <span class="route-city route-city--one">DOUALA</span><span class="route-city route-city--two">YAOUNDÉ</span>
      <svg viewBox="0 0 300 160"><path d="M25 125C80 8 167 147 276 31" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 7" /><circle cx="25" cy="125" r="7" /><circle cx="276" cy="31" r="7" /></svg>
      <div class="route-services"><span>Covoiturage</span><span>Colis</span><span>Location</span></div>
    </div>
  )}
  {kind === 'alert' && (
    <div class="alert-map" aria-hidden="true">
      <div class="zone zone--large"></div><div class="zone zone--small"></div>
      <div class="person person--one">M</div><div class="person person--two">L</div>
      <div class="alert-label"><span></span>Zone active · position connue</div>
    </div>
  )}
  {kind === 'books' && (
    <Image src={liliBooksImage} alt={`Capture de l’interface publique du projet ${title}`} widths={[480, 720, 960]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" loading="lazy" />
  )}
</div>

<style>
  .project-visual { position: relative; min-height: 23rem; overflow: hidden; background: var(--surface-soft); color: var(--color-mineral-700); }
  .project-visual--compact { min-height: 17rem; }
  .learning-map, .route-map, .alert-map { position: absolute; inset: 0; }
  .learning-map { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4); padding: clamp(1.5rem, 5vw, 4rem); background: linear-gradient(135deg, var(--color-white), var(--color-mineral-200)); }
  .class-pill { position: absolute; top: var(--space-5); left: var(--space-5); padding: 0.45rem 0.7rem; border: 1px solid currentColor; font: 600 var(--font-size-label)/1 var(--font-utility); }
  .score { display: grid; gap: var(--space-2); }
  .score small { font: 600 var(--font-size-label)/1 var(--font-utility); }
  .score strong { font: 700 clamp(2rem, 7vw, 4.5rem)/1 var(--font-display); letter-spacing: -0.06em; }
  .score--after { color: var(--accent-proof); text-align: right; }
  .learning-map svg { width: min(9rem, 22vw); }
  .route-map { padding: var(--space-5); background: var(--color-mineral-700); color: var(--color-white); }
  .route-map svg { position: absolute; inset: 2rem; width: calc(100% - 4rem); height: calc(100% - 4rem); }
  .route-map circle { fill: var(--accent-proof); stroke: var(--color-white); stroke-width: 2; }
  .route-city { position: absolute; z-index: 2; font: 600 var(--font-size-label)/1 var(--font-utility); }
  .route-city--one { left: var(--space-5); bottom: 2.25rem; }
  .route-city--two { top: var(--space-5); right: var(--space-5); }
  .route-services { position: absolute; right: var(--space-5); bottom: var(--space-4); display: flex; gap: var(--space-3); color: var(--color-mineral-200); font: 500 0.65rem/1 var(--font-utility); text-transform: uppercase; }
  .alert-map { background-image: linear-gradient(var(--color-mineral-300) 1px, transparent 1px), linear-gradient(90deg, var(--color-mineral-300) 1px, transparent 1px); background-size: 2.5rem 2.5rem; }
  .zone { position: absolute; border: 2px solid var(--accent-proof); border-radius: 50%; background: color-mix(in srgb, var(--color-copper-100) 55%, transparent); }
  .zone--large { width: 15rem; height: 15rem; top: 12%; left: 18%; }
  .zone--small { width: 7rem; height: 7rem; right: 12%; bottom: 9%; border-color: var(--color-mineral-700); }
  .person { position: absolute; z-index: 2; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 3px solid var(--color-white); border-radius: 50%; background: var(--color-ink-950); color: var(--color-white); font: 600 var(--font-size-label)/1 var(--font-utility); }
  .person--one { top: 41%; left: 42%; }.person--two { right: 20%; bottom: 24%; background: var(--accent-proof); }
  .alert-label { position: absolute; left: var(--space-5); bottom: var(--space-5); display: flex; align-items: center; gap: var(--space-2); padding: 0.6rem 0.75rem; background: var(--surface-raised); font: 500 var(--font-size-label)/1.3 var(--font-utility); }
  .alert-label span { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--color-success-700); }
  .project-visual--books :global(img) { width: 100%; height: 100%; min-height: inherit; object-fit: cover; object-position: top center; }
  @media (max-width: 32rem) { .route-services { display: none; } .learning-map { grid-template-columns: 1fr; align-content: center; }.learning-map svg { display: none; }.score--after { text-align: left; } }
</style>

