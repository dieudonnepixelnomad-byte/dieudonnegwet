---
import alertContactsBanner from '@/assets/projects/banner_alertcontacts.png';
import completeLearningBanner from '@/assets/projects/banner_complete_learning.png';
import liliBooksImage from '@/assets/projects/lili-books.png';
import liliRideBanner from '@/assets/projects/banner_liliride.png';
import { Image } from 'astro:assets';

interface Props {
  kind: 'learning' | 'ride' | 'alert' | 'books';
  title: string;
  compact?: boolean;
}

const { kind, title, compact = false } = Astro.props;

const projectImages = {
  learning: completeLearningBanner,
  ride: liliRideBanner,
  alert: alertContactsBanner,
  books: liliBooksImage,
};
---

<div class:list={['project-visual', `project-visual--${kind}`, { 'project-visual--compact': compact }]}>
  <Image
    src={projectImages[kind]}
    alt={`Bannière du projet ${title}`}
    widths={[480, 720, 960, 1440]}
    sizes="(max-width: 48rem) 100vw, 50vw"
    format="webp"
    loading="lazy"
  />
</div>

<style>
  .project-visual {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-soft);
  }

  .project-visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project-visual--books :global(img) {
    object-position: top center;
  }
</style>
