---
export const prerender = true;
import FinalCta from '@/components/FinalCta.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const included = [
  ['Cadrage stratégique', 'Positionnement, cible prioritaire, objections, preuves disponibles et parcours de conversion.'],
  ['Structure et contenus', 'Entretiens de collecte, architecture de l’information, rédaction essentielle et deux études de cas.'],
  ['Direction visuelle', 'Système de couleurs, typographies, composants, écrans représentatifs et deux cycles consolidés de corrections.'],
  ['Conception et développement', 'Jusqu’à sept pages, une langue, un formulaire, intégration des contenus et adaptation responsive.'],
  ['Fondamentaux techniques', 'Performance de base, métadonnées, sitemap, mesure des actions essentielles et vérifications avant lancement.'],
  ['Transmission', 'Mise en ligne, session de prise en main, documentation essentielle et stabilisation de 30 jours.'],
];

const phases = [
  ['01', 'Cadrage et collecte', 'Comprendre l’activité, les clients, les objections et sélectionner les preuves utilisables.'],
  ['02', 'Structure et contenus', 'Définir le plan, les messages, les études de cas et le parcours de contact.'],
  ['03', 'Direction visuelle', 'Concevoir l’univers du site et valider les écrans représentatifs.'],
  ['04', 'Développement', 'Construire le site, intégrer les contenus et adapter chaque composant aux différents écrans.'],
  ['05', 'Vérification et lancement', 'Tester, corriger le périmètre convenu, transmettre et mettre en ligne.'],
];
---

<BaseLayout title="Évidence — Site de crédibilité pour PME | Dieudonne Gwet" description="Évidence transforme les réalisations, la méthode et les garanties d’une PME en un site clair, crédible et mesurable.">
  <PageHero eyebrow="Offre principale" title="Évidence" lead="Une mission de stratégie, de structuration des contenus, de direction visuelle et de développement pour rendre votre valeur compréhensible avant le premier contact." reference="OFFRE / VERSION 01 · STUDIO DIGITAL INDÉPENDANT">
    <div class="hero-actions"><a class="button" href="/diagnostic">Demander mon diagnostic</a><a class="button button--secondary" href="#perimetre">Voir le périmètre</a></div>
  </PageHero>

  <section class="section statement-section">
    <div class="container statement-grid">
      <div><p class="eyebrow">Le constat</p><h2>Votre travail peut être solide sans être encore lisible en ligne.</h2></div>
      <div class="statement-copy"><p>Lorsque les réalisations sont dispersées entre les réseaux sociaux, les téléphones et un ancien site, un prospect doit reconstruire lui-même les raisons de vous faire confiance.</p><p>Évidence organise ce matériau. La mission ne promet ni un volume de prospects, ni une position dans Google, ni une hausse automatique du chiffre d’affaires. Elle construit une présence plus claire et mesurable.</p></div>
    </div>
  </section>

  <section class="section section--soft" id="perimetre">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Ce qui est inclus</p><h2>Un seul projet, de la réflexion à la mise en ligne.</h2></div><p class="section-head__intro">Vous ne recevez pas une maquette isolée d’un côté et du code sans contenu de l’autre. Les décisions sont reliées au même objectif de compréhension.</p></div>
      <div class="included-grid">
        {included.map(([title, text], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section scope-section">
    <div class="container scope-grid">
      <div class="scope-card">
        <p class="eyebrow">Périmètre de référence</p>
        <ol>
          <li>Accueil</li><li>Service ou offre principale</li><li>Méthode / À propos</li><li>Réalisations</li><li>Étude de cas 1</li><li>Étude de cas 2</li><li>Contact / demande de diagnostic</li>
        </ol>
      </div>
      <div>
        <p class="eyebrow">Investissement</p>
        <p class="price">À partir de<br />1 200 000 FCFA</p>
        <p>Le prix définitif dépend du nombre de pages, du volume de contenu, des fonctionnalités, de l’état des éléments existants et du niveau d’accompagnement.</p>
        <div class="payment-grid"><span>50 %<small>Démarrage</small></span><span>30 %<small>Direction validée</small></span><span>20 %<small>Avant mise en ligne</small></span></div>
        <p class="duration">DURÉE INDICATIVE / 5 À 7 SEMAINES</p>
      </div>
    </div>
  </section>

  <section class="section process-detail section--strong">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow eyebrow--inverse">Déroulement</p><h2>Cinq phases, des validations visibles.</h2></div><p class="section-head__intro">Le calendrier suppose que les contenus, accès et retours consolidés soient fournis aux dates convenues.</p></div>
      <ol class="phase-list">
        {phases.map(([number, title, text]) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section exclusions-section">
    <div class="container exclusions-grid">
      <div><p class="eyebrow">Limites</p><h2>Ce que le périmètre de départ ne comprend pas.</h2><p>Ces exclusions évitent les attentes implicites et permettent de chiffrer séparément ce qui relève d’un autre métier ou d’une autre phase.</p></div>
      <ul class="fact-list">
        <li>Photographie et production vidéo</li><li>Identité de marque complète ou logo complexe</li><li>Traduction et rédaction multilingue</li><li>Boutique en ligne ou espace membre</li><li>CRM et automatisations avancées</li><li>Maintenance permanente et référencement mensuel</li><li>Google Ads, Facebook Ads et Instagram Ads</li><li>Modifications illimitées</li>
      </ul>
    </div>
  </section>

  <section class="section options-section section--soft">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Prestations complémentaires</p><h2>Étendre la preuve sans diluer le projet.</h2></div><p class="section-head__intro">Chaque complément possède un périmètre distinct. Aucun abonnement n’est ajouté par défaut.</p></div>
      <div class="options-grid">
        <article><p>OPTION / 01</p><h3>Pack Réalisations</h3><strong>À partir de 250 000 FCFA</strong><span>Deux études de cas supplémentaires structurées à partir des informations disponibles.</span></article>
        <article><p>OPTION / 02</p><h3>Visibilité locale</h3><strong>200 000 à 350 000 FCFA</strong><span>Structuration de la présence locale, sans garantie de position déterminée.</span></article>
        <article><p>OPTION / 03</p><h3>Pilotage de crédibilité</h3><strong>À partir de 120 000 FCFA / mois</strong><span>Revue mensuelle et petites améliorations dans un périmètre défini.</span></article>
      </div>
    </div>
  </section>

  <FinalCta title="Évidence est-elle adaptée à votre entreprise ?" text="Le diagnostic permet d’identifier les écarts, de classer les priorités et de vérifier si une refonte complète est réellement justifiée." />
</BaseLayout>

<style>
  .statement-grid, .scope-grid, .exclusions-grid { display: grid; gap: var(--space-8); }
  .statement-grid h2, .exclusions-grid h2 { max-width: 14ch; }
  .statement-copy { max-width: 42rem; font-size: var(--font-size-body-lg); }
  .statement-copy p:last-child { color: var(--text-secondary); }
  .included-grid { display: grid; gap: 1px; border: 1px solid var(--border-default); background: var(--border-default); }
  .included-grid article { min-height: 17rem; padding: var(--space-5); background: var(--surface-page); }
  .included-grid span, .options-grid article > p { color: var(--accent-proof); font: 600 var(--font-size-label)/1.4 var(--font-utility); }
  .included-grid h3 { margin-top: var(--space-7); }
  .included-grid p { margin: var(--space-4) 0 0; color: var(--text-secondary); }
  .scope-card { padding: var(--space-6); background: var(--surface-strong); color: var(--text-inverse); }
  .scope-card ol { margin: var(--space-6) 0 0; padding: 0; list-style: none; counter-reset: scope; }
  .scope-card li { min-height: 3.5rem; display: grid; grid-template-columns: 2rem 1fr; align-items: center; border-top: 1px solid color-mix(in srgb, var(--color-white) 24%, transparent); counter-increment: scope; }
  .scope-card li::before { content: counter(scope, decimal-leading-zero); color: var(--color-mineral-300); font: 500 var(--font-size-label)/1 var(--font-utility); }
  .payment-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-block: var(--space-6); border: 1px solid var(--border-default); background: var(--border-default); }
  .payment-grid span { min-height: 7rem; display: grid; align-content: space-between; padding: var(--space-4); background: var(--surface-raised); font: 700 1.6rem/1 var(--font-display); }
  .payment-grid small, .duration { font: 500 var(--font-size-label)/1.4 var(--font-utility); }
  .phase-list { margin: 0; padding: 0; border-top: 1px solid color-mix(in srgb, var(--color-white) 32%, transparent); list-style: none; }
  .phase-list li { display: grid; gap: var(--space-4); padding: var(--space-5) 0; border-bottom: 1px solid color-mix(in srgb, var(--color-white) 22%, transparent); }
  .phase-list span { color: var(--color-mineral-300); font: 600 var(--font-size-label)/1.4 var(--font-utility); }
  .phase-list p { max-width: 38rem; margin: 0; color: var(--color-mineral-200); }
  .exclusions-grid > div > p:last-child { max-width: 36rem; color: var(--text-secondary); }
  .options-grid { display: grid; gap: var(--space-5); }
  .options-grid article { min-height: 20rem; display: grid; align-content: start; padding: var(--space-5); border: 1px solid var(--border-default); background: var(--surface-raised); }
  .options-grid h3 { margin-top: var(--space-7); }
  .options-grid strong { margin-top: var(--space-5); font-family: var(--font-display); font-size: 1.4rem; }
  .options-grid span { margin-top: var(--space-4); color: var(--text-secondary); }
  @media (min-width: 48rem) {
    .statement-grid, .scope-grid, .exclusions-grid { grid-template-columns: 1fr 1fr; align-items: start; }
    .included-grid { grid-template-columns: repeat(2, 1fr); }
    .phase-list li { grid-template-columns: 3rem 0.7fr 1.3fr; align-items: start; }
    .options-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 64rem) { .included-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 32rem) { .payment-grid { grid-template-columns: 1fr; }.payment-grid span { min-height: 5rem; } }
</style>

